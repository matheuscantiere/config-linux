/* rofi — launcher and clipboard picker for Hyprland */

configuration {
    modes:                      "drun,run,window";
    font:                       "Ubuntu Sans 11";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    drun-display-format:        "{name}";
    display-drun:               "Apps";
    display-run:                "Run";
    display-window:             "Windows";
    window-format:              "{w} · {c} · {t}";
    terminal:                   "kitty";
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

@theme "catppuccin-macchiato"
